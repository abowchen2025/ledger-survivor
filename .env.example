# 複製為 .env 後依本機環境調整；.env 不進版控

# PostgreSQL 連線字串（本機 docker compose 的 db 服務）
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:55432/ledger_survivor
COMPOSE_PROJECT_NAME=ledger-survivor
DEBUG=false
TZ=Asia/Taipei

# DB 對外埠。不用預設 5432：這台機器的 5432 已被另一個專案（rachel-qa）的 PostgreSQL 佔用，
# 改映射到 55432 避免撞埠；容器內仍是 5432。改這裡時 DATABASE_URL 的埠要一起改。
DB_PORT=55432

# 後端 uvicorn 埠。不用預設 8000：本機 8000 同樣被 rachel-qa 佔用，改用 8765。
# 前端 npm run gen:api 讀 http://localhost:${API_PORT}/openapi.json
API_PORT=8765
